+bool PeerConnectionImpl::ShouldSpoofCandidateIP() const {
+  if (!mWindow) {
+    return false;
+  }
+
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = mWindow->GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
