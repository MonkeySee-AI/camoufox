+mozilla::ipc::IPCResult WindowGlobalParent::RecvDrawElementSnapshot(
+    gfx::PaintFragment&& aFragment,
+    DrawElementSnapshotResolver&& aResolve) {
+  RefPtr<gfx::CrossProcessPaint::ResolvePromise> promise =
+      gfx::CrossProcessPaint::Start(
+          std::move(aFragment),
+          gfx::CrossProcessPaintFlags::UseHighQualityScaling);
+  promise->Then(
+      GetMainThreadSerialEventTarget(), __func__,
+      [resolve = std::move(aResolve)](
+          gfx::CrossProcessPaint::ResolvePromise::ResolveOrRejectValue&&
+              aResult) mutable {
+        if (aResult.IsReject()) {
+          resolve(nsCString());
+          return;
+        }
+        gfx::CrossProcessPaint::ResolvedFragmentMap aFragments =
+            std::move(aResult.ResolveValue());
+        RefPtr<gfx::RecordedDependentSurface> root = aFragments.Get(TabId(0));
+        if (!root) {
+          resolve(nsCString());
+          return;
+        }
+        RefPtr<gfx::DrawTarget> drawTarget =
+            gfxPlatform::GetPlatform()->CreateOffscreenContentDrawTarget(
+                root->mSize, gfx::SurfaceFormat::B8G8R8A8);
+        if (!drawTarget || !drawTarget->IsValid()) {
+          resolve(nsCString());
+          return;
+        }
+        gfx::InlineTranslator translator(drawTarget, nullptr);
+        translator.SetDependentSurfaces(&aFragments);
+        if (!translator.TranslateRecording((char*)root->mRecording.mData,
+                                           root->mRecording.mLen)) {
+          resolve(nsCString());
+          return;
+        }
+        RefPtr<gfx::SourceSurface> snapshot = drawTarget->Snapshot();
+        if (!snapshot) {
+          resolve(nsCString());
+          return;
+        }
+        Maybe<nsTArray<uint8_t>> bytes =
+            gfxUtils::EncodeSourceSurfaceAsBytes(
+                snapshot, ImageType::PNG, u""_ns);
+        if (!bytes) {
+          resolve(nsCString());
+          return;
+        }
+        nsCString data;
+        nsDependentCSubstring raw(
+            reinterpret_cast<const char*>(bytes->Elements()), bytes->Length());
+        if (NS_FAILED(Base64Encode(raw, data))) {
+          resolve(nsCString());
+          return;
+        }
+        resolve(std::move(data));
+      });
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult WindowGlobalParent::RecvEncodeElementVideoFrame(
+    gfx::PaintFragment&& aFragment, bool aFillOutput, uint32_t aWidth,
+    uint32_t aHeight,
+    uint32_t aFramesPerSecond, uint32_t aBitsPerSecond,
+    const nsCString& aCodec, uint64_t aFrameIndex,
+    EncodeElementVideoFrameResolver&& aResolve) {
+  if (!aCodec.EqualsLiteral("h264") && !aCodec.EqualsLiteral("h265")) {
+    aResolve(nsCString());
+    return IPC_OK();
+  }
+  const ElementVideoStream::Options options{
+      aWidth, aHeight, aFramesPerSecond, aBitsPerSecond,
+      aCodec.EqualsLiteral("h265"), aFillOutput};
+  RefPtr<gfx::CrossProcessPaint::ResolvePromise> paint =
+      gfx::CrossProcessPaint::Start(
+          std::move(aFragment),
+          gfx::CrossProcessPaintFlags::UseHighQualityScaling);
+  auto resolver = std::make_shared<EncodeElementVideoFrameResolver>(
+      std::move(aResolve));
+  paint->Then(
+      GetMainThreadSerialEventTarget(), __func__,
+      [self = RefPtr{this}, options, aFrameIndex, resolver](
+          gfx::CrossProcessPaint::ResolvePromise::ResolveOrRejectValue&&
+              aResult) mutable {
+        if (aResult.IsReject() || !self->CanSend()) {
+          (*resolver)(nsCString());
+          return;
+        }
+        gfx::CrossProcessPaint::ResolvedFragmentMap fragments =
+            std::move(aResult.ResolveValue());
+
+        auto encode = [self, aFrameIndex, resolver](
+                gfx::CrossProcessPaint::ResolvedFragmentMap&& aFragments)
+                mutable {
+              self->mElementVideoStream
+                  ->Encode(std::move(aFragments), aFrameIndex)
+                  ->Then(
+                      GetMainThreadSerialEventTarget(), __func__,
+                      [resolver](nsCString&& aPacket) mutable {
+                        nsCString data;
+                        if (aPacket.IsEmpty() ||
+                            NS_FAILED(Base64Encode(aPacket, data))) {
+                          (*resolver)(nsCString());
+                        } else {
+                          (*resolver)(std::move(data));
+                        }
+                      },
+                      [resolver](const MediaResult&) mutable {
+                        (*resolver)(nsCString());
+                      });
+            };
+
+        if (self->mElementVideoStream &&
+            !self->mElementVideoStream->Matches(options)) {
+          self->mElementVideoStream->Shutdown();
+          self->mElementVideoStream = nullptr;
+        }
+        if (self->mElementVideoStream) {
+          encode(std::move(fragments));
+          return;
+        }
+
+        ElementVideoStream::Create(options)->Then(
+            GetMainThreadSerialEventTarget(), __func__,
+            [self, fragments = std::move(fragments),
+             encode = std::move(encode), resolver](
+                RefPtr<ElementVideoStream>&& aStream) mutable {
+              if (!self->CanSend()) {
+                aStream->Shutdown();
+                (*resolver)(nsCString());
+                return;
+              }
+              self->mElementVideoStream = std::move(aStream);
+              encode(std::move(fragments));
+            },
+            [resolver](const MediaResult&) mutable {
+              (*resolver)(nsCString());
+            });
+      });
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult WindowGlobalParent::RecvStopElementVideoStream(
+    StopElementVideoStreamResolver&& aResolve) {
+  if (mElementVideoStream) {
+    mElementVideoStream->Shutdown();
+    mElementVideoStream = nullptr;
+  }
+  aResolve(true);
+  return IPC_OK();
+}
