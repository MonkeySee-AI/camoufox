+/* static */
+PaintFragment PaintFragment::RecordElement(dom::Element* aElement,
+                                           float aScale) {
+  if (!aElement || aScale <= 0) {
+    return PaintFragment{};
+  }
+
+  dom::Document* document = aElement->OwnerDoc();
+  nsContentUtils::FlushLayoutForTree(document->GetWindow());
+  nsIFrame* rootFrame = aElement->GetPrimaryFrame();
+  if (!rootFrame) {
+    return PaintFragment{};
+  }
+  rootFrame = rootFrame->FirstContinuation();
+
+  nsRect inkOverflow;
+  bool hasInk = false;
+  for (nsIFrame* frame = rootFrame; frame;
+       frame = frame->GetNextContinuation()) {
+    nsRect rect = frame->InkOverflowRect();
+    rect.MoveBy(frame->GetOffsetTo(rootFrame));
+    if (hasInk) {
+      inkOverflow.UnionRect(inkOverflow, rect);
+    } else {
+      inkOverflow = rect;
+      hasInk = true;
+    }
+  }
+  if (!hasInk || inkOverflow.IsEmpty()) {
+    return PaintFragment{};
+  }
+
+  RefPtr<nsPresContext> presContext = rootFrame->PresContext();
+  CSSIntRect rect = RoundedOut(CSSPixel::FromAppUnits(inkOverflow));
+  IntSize surfaceSize(int32_t(std::ceil(rect.width * aScale)),
+                      int32_t(std::ceil(rect.height * aScale)));
+  if (surfaceSize.IsEmpty() || !Factory::CheckSurfaceSize(surfaceSize)) {
+    return PaintFragment{};
+  }
+
+  SurfaceFormat format = SurfaceFormat::B8G8R8A8;
+  RefPtr<DrawTarget> referenceDt = Factory::CreateDrawTarget(
+      gfxPlatform::GetPlatform()->GetSoftwareBackend(), IntSize(1, 1), format);
+  RefPtr<DrawEventRecorderMemory> recorder =
+      MakeAndAddRef<DrawEventRecorderMemory>(nullptr);
+  RefPtr<DrawTarget> dt = Factory::CreateRecordingDrawTarget(
+      recorder, referenceDt, IntRect(IntPoint(), surfaceSize));
+  if (!dt || !dt->IsValid()) {
+    return PaintFragment{};
+  }
+
+  gfxContext context(dt);
+  context.SetMatrix(Matrix::Scaling(aScale, aScale));
+  context.SetCrossProcessPaintScale(aScale);
+  gfxFloat cssToDev = gfxFloat(presContext->AppUnitsPerDevPixel()) /
+                      AppUnitsPerCSSPixel();
+  gfxPoint offset(-rect.x, -rect.y);
+  context.SetMatrixDouble(context.CurrentMatrixDouble()
+                              .PreTranslate(offset)
+                              .PreScale(cssToDev, cssToDev)
+                              .NudgeToIntegers());
+
+  using PaintFrameFlags = nsLayoutUtils::PaintFrameFlags;
+  PaintFrameFlags flags = PaintFrameFlags::InTransform |
+                          PaintFrameFlags::SyncDecodeImages |
+                          PaintFrameFlags::IgnoreSuppression |
+                          PaintFrameFlags::HideCaret |
+                          PaintFrameFlags::UseHighQualityScaling;
+  nsLayoutUtils::PaintFrame(&context, rootFrame,
+                            nsRegion(CSSPixel::ToAppUnits(rect)),
+                            NS_RGBA(0, 0, 0, 0),
+                            nsDisplayListBuilderMode::Painting, flags);
+
+  if (!recorder->mOutputStream.mValid) {
+    recorder->DetachResources();
+    return PaintFragment{};
+  }
+
+  ByteBuf recording = ByteBuf((uint8_t*)recorder->mOutputStream.mData,
+                              recorder->mOutputStream.mLength,
+                              recorder->mOutputStream.mCapacity);
+  recorder->mOutputStream.mData = nullptr;
+  recorder->mOutputStream.mLength = 0;
+  recorder->mOutputStream.mCapacity = 0;
+
+  nsTHashSet<uint64_t> dependencies = recorder->TakeDependentSurfaces();
+  recorder->DetachResources();
+  return PaintFragment{surfaceSize, std::move(recording),
+                       std::move(dependencies)};
+}
