+already_AddRefed<Promise> WindowGlobalChild::DrawElementSnapshot(
+    Element& aElement, double aScale, ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mWindowGlobal->AsGlobal(), aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  if (aScale <= 0 || aElement.OwnerDoc() != mWindowGlobal->GetExtantDoc()) {
+    promise->MaybeReject(NS_ERROR_INVALID_ARG);
+    return promise.forget();
+  }
+
+  gfx::PaintFragment fragment =
+      gfx::PaintFragment::RecordElement(&aElement, aScale);
+  if (fragment.IsEmpty()) {
+    promise->MaybeReject(NS_ERROR_FAILURE);
+    return promise.forget();
+  }
+
+  SendDrawElementSnapshot(std::move(fragment))
+      ->Then(GetCurrentSerialEventTarget(), __func__,
+             [promise](PWindowGlobalChild::DrawElementSnapshotPromise::
+                           ResolveOrRejectValue&& aResult) {
+               if (aResult.IsResolve()) {
+                 const nsCString& data = aResult.ResolveValue();
+                 if (data.IsEmpty()) {
+                   promise->MaybeReject(NS_ERROR_FAILURE);
+                 } else {
+                   promise->MaybeResolve(NS_ConvertUTF8toUTF16(data));
+                 }
+               } else {
+                 promise->MaybeReject(NS_ERROR_FAILURE);
+               }
+             });
+  return promise.forget();
+}
+
+already_AddRefed<Promise> WindowGlobalChild::EncodeElementVideoFrame(
+    Element* aElement, uint32_t aWidth, uint32_t aHeight,
+    uint32_t aFramesPerSecond, uint32_t aBitsPerSecond,
+    const nsACString& aCodec, uint64_t aFrameIndex, ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mWindowGlobal->AsGlobal(), aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  if ((aElement && aElement->OwnerDoc() != mWindowGlobal->GetExtantDoc()) ||
+      aWidth < 2 ||
+      aHeight < 2 || aWidth > 8192 || aHeight > 8192 || aWidth % 2 ||
+      aHeight % 2 || aFramesPerSecond < 1 || aFramesPerSecond > 60 ||
+      aBitsPerSecond < 1000 || aBitsPerSecond > 500000000 ||
+      (!aCodec.EqualsLiteral("h264") && !aCodec.EqualsLiteral("h265"))) {
+    promise->MaybeReject(NS_ERROR_INVALID_ARG);
+    return promise.forget();
+  }
+
+  dom::Document* document = mWindowGlobal->GetExtantDoc();
+  nsPresContext* presContext = document ? document->GetPresContext() : nullptr;
+  Maybe<gfx::IntRect> viewport;
+  if (!aElement && presContext) {
+    CSSIntRect visible =
+        RoundedOut(CSSPixel::FromAppUnits(presContext->GetVisibleArea()));
+    viewport.emplace(visible.x, visible.y, visible.width, visible.height);
+  }
+  gfx::PaintFragment fragment =
+      aElement
+          ? gfx::PaintFragment::RecordElement(aElement, 1.0f)
+          : viewport
+                ? gfx::PaintFragment::Record(
+                      BrowsingContext(), viewport, 1.0f,
+                      NS_RGB(255, 255, 255),
+                      gfx::CrossProcessPaintFlags::DrawView |
+                          gfx::CrossProcessPaintFlags::UseHighQualityScaling)
+                : gfx::PaintFragment{};
+  if (fragment.IsEmpty()) {
+    promise->MaybeReject(NS_ERROR_FAILURE);
+    return promise.forget();
+  }
+
+  SendEncodeElementVideoFrame(std::move(fragment), !aElement, aWidth, aHeight,
+                              aFramesPerSecond, aBitsPerSecond,
+                              nsCString(aCodec), aFrameIndex)
+      ->Then(GetCurrentSerialEventTarget(), __func__,
+             [promise](PWindowGlobalChild::EncodeElementVideoFramePromise::
+                           ResolveOrRejectValue&& aResult) {
+               if (aResult.IsResolve() &&
+                   !aResult.ResolveValue().IsEmpty()) {
+                 promise->MaybeResolve(
+                     NS_ConvertUTF8toUTF16(aResult.ResolveValue()));
+               } else {
+                 promise->MaybeReject(NS_ERROR_FAILURE);
+               }
+             });
+  return promise.forget();
+}
+
+already_AddRefed<Promise> WindowGlobalChild::StopElementVideoStream(
+    ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mWindowGlobal->AsGlobal(), aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  SendStopElementVideoStream()->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [promise](PWindowGlobalChild::StopElementVideoStreamPromise::
+                    ResolveOrRejectValue&& aResult) {
+        if (aResult.IsResolve()) {
+          promise->MaybeResolve(aResult.ResolveValue());
+        } else {
+          promise->MaybeReject(NS_ERROR_FAILURE);
+        }
+      });
+  return promise.forget();
+}
