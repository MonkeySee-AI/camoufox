+void AppleVTEncoder::ProcessPipelinedEncode(
+    const RefPtr<const VideoData>& aSample,
+    const RefPtr<EncodePromise::Private>& aPromise) {
+  AssertOnTaskQueue();
+  if (!mSession) {
+    mPipelinedPromises.RemoveElement(aPromise);
+    aPromise->Reject(
+        MediaResult(NS_ERROR_DOM_MEDIA_CANCELED, "Encoder is stopped"_ns),
+        __func__);
+    return;
+  }
+
+  AutoCVBufferRef<CVImageBufferRef> buffer(
+      CreateCVPixelBuffer(aSample->mImage));
+  if (!buffer) {
+    mPipelinedPromises.RemoveElement(aPromise);
+    aPromise->Reject(
+        MediaResult(NS_ERROR_OUT_OF_MEMORY, "failed to allocate buffer"_ns),
+        __func__);
+    return;
+  }
+
+  CFDictionaryRef frameProps = nullptr;
+  if (aSample->mKeyframe) {
+    const void* keys[] = {kVTEncodeFrameOptionKey_ForceKeyFrame};
+    const void* values[] = {kCFBooleanTrue};
+    frameProps = CFDictionaryCreate(
+        kCFAllocatorDefault, keys, values, std::size(keys),
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+  }
+  auto releaseProps = MakeScopeExit([&] {
+    if (frameProps) {
+      CFRelease(frameProps);
+    }
+  });
+
+  VTEncodeInfoFlags info;
+  OSStatus status = VTCompressionSessionEncodeFrame(
+      mSession, buffer,
+      CMTimeMake(aSample->mTime.ToMicroseconds(), USECS_PER_S),
+      CMTimeMake(aSample->mDuration.ToMicroseconds(), USECS_PER_S), frameProps,
+      aPromise.get(), &info);
+  if (status != noErr) {
+    mPipelinedPromises.RemoveElement(aPromise);
+    aPromise->Reject(
+        MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                    "VTCompressionSessionEncodeFrame error"_ns),
+        __func__);
+  }
+}
+
+void AppleVTEncoder::CompletePipelinedEncode(
+    const RefPtr<EncodePromise::Private>& aPromise) {
+  AssertOnTaskQueue();
+  if (!mPipelinedPromises.RemoveElement(aPromise)) {
+    return;
+  }
+  if (NS_FAILED(mError)) {
+    MediaResult error = std::move(mError);
+    mError = NS_OK;
+    aPromise->Reject(std::move(error), __func__);
+    return;
+  }
+  EncodedData output = std::move(mEncodedData);
+  mEncodedData = EncodedData();
+  aPromise->Resolve(std::move(output), __func__);
+}
