+already_AddRefed<Promise> WindowGlobalChild::DrawElementSnapshot(
+    Element& aElement, double aScale, ErrorResult& aRv) {
+  RefPtr<Promise> promise = Promise::Create(mWindowGlobal->AsGlobal(), aRv);
+  if (aRv.Failed()) {
+    return nullptr;
+  }
+  if (aScale <= 0 || aElement.OwnerDoc() != mWindowGlobal->GetExtantDoc()) {
+    promise->MaybeReject(NS_ERROR_INVALID_ARG);
+    return promise.forget();
+  }
+
+  gfx::PaintFragment fragment =
+      gfx::PaintFragment::RecordElement(&aElement, aScale);
+  if (fragment.IsEmpty()) {
+    promise->MaybeReject(NS_ERROR_FAILURE);
+    return promise.forget();
+  }
+
+  SendDrawElementSnapshot(std::move(fragment))
+      ->Then(GetCurrentSerialEventTarget(), __func__,
+             [promise](PWindowGlobalChild::DrawElementSnapshotPromise::
+                           ResolveOrRejectValue&& aResult) {
+               if (aResult.IsResolve()) {
+                 const nsCString& data = aResult.ResolveValue();
+                 if (data.IsEmpty()) {
+                   promise->MaybeReject(NS_ERROR_FAILURE);
+                 } else {
+                   promise->MaybeResolve(NS_ConvertUTF8toUTF16(data));
+                 }
+               } else {
+                 promise->MaybeReject(NS_ERROR_FAILURE);
+               }
+             });
+  return promise.forget();
+}
