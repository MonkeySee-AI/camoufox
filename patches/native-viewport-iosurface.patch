 void NativeLayerRootSnapshotterCA::UpdateSnapshot(const IntSize& aSize) {
+  bool needToRedrawEverything = false;
+  if (!mSnapshot || mSnapshot->Size() != aSize) {
+    mSnapshot = nullptr;
