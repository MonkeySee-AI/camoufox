 void NativeLayerRootSnapshotterCA::UpdateSnapshot(const IntSize& aSize) {
+  bool needToRedrawEverything = false;
+  if (!mSnapshot || mSnapshot->Size() != aSize) {
+    mSnapshot = nullptr;
+    auto fb = gl::MozFramebuffer::Create(mGL, aSize, 0, false);
+    if (!fb) {
+      return;
+    }
+    mSnapshot = new RenderSourceNLRS(std::move(fb));
+    needToRedrawEverything = true;
+  }
+
+  RenderSnapshot(aSize, mSnapshot->FB().mFB, needToRedrawEverything);
+}
+
+already_AddRefed<MacIOSurface> NativeLayerRootSnapshotterCA::GetWindowIOSurface(
+    const IntSize& aWindowSize) {
+  if (!mIOSurfaceSnapshot ||
+      mIOSurfaceSnapshot->mIOSurf->GetSize() != aWindowSize) {
+    const gl::SharedSurfaceDesc desc{
+        {mGL.get(), gl::SharedSurfaceType::IOSurface, TextureType::MacIOSurface,
+         true},
+        aWindowSize,
+        gfx::ColorSpace2::SRGB};
+    mIOSurfaceSnapshot = gl::SharedSurface_IOSurface::Create(desc);
+  }
+  if (!mIOSurfaceSnapshot) {
+    return nullptr;
+  }
+
+  // This target is independent from profiler screenshots, so fill every
+  // pixel even when Core Animation reports only a partial dirty rectangle.
+  RenderSnapshot(aWindowSize, mIOSurfaceSnapshot->mFb->mFB, true);
+  mGL->fFlush();
+  return do_AddRef(mIOSurfaceSnapshot->mIOSurf);
+}
