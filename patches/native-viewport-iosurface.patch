+}
+
+already_AddRefed<MacIOSurface> NativeLayerRootSnapshotterCA::GetWindowIOSurface(
+    const IntSize& aWindowSize) {
+  // A fresh surface per call: consumers may still be reading a previously
+  // returned surface, so re-rendering a cached one would tear.
+  const gl::SharedSurfaceDesc desc{
+      {mGL.get(), gl::SharedSurfaceType::IOSurface, TextureType::MacIOSurface,
+       true},
+      aWindowSize,
+      gfx::ColorSpace2::SRGB};
+  UniquePtr<gl::SharedSurface_IOSurface> surface =
+      gl::SharedSurface_IOSurface::Create(desc);
+  if (!surface) {
+    return nullptr;
+  }
+
+  // This target is independent from profiler screenshots, so fill every
+  // pixel even when Core Animation reports only a partial dirty rectangle.
+  RenderSnapshot(aWindowSize, surface->mFb->mFB, true);
+  // The consumer reads the IOSurface through another API on another thread,
+  // so the GL work must be complete, not merely flushed, before handoff.
+  mGL->fFinish();
+  return do_AddRef(surface->mIOSurf);
+}
