XPIDL_SOURCES += [
    'nsIScreencastService.idl',
]

XPIDL_MODULE = 'jugglerscreencast'

SOURCES += [
    'ElementVideoStream.cpp',
    'HeadlessWindowCapturer.cpp',
    'nsScreencastService.cpp',
    'ScreencastEncoder.cpp',
]

EXPORTS.mozilla.dom += [
    'ElementVideoStream.h',
]

XPCOM_MANIFESTS += [
    'components.conf',
]

LOCAL_INCLUDES += [
    '!/dist/include/libwebrtc_overrides',
    '/dom/media',
    '/dom/media/platforms',
    '/dom/media/systemservices',
    '/dom/media/webcodecs',
    '/media/libyuv/libyuv/include',
    '/third_party/abseil-cpp',
    '/third_party/libwebrtc',
]

if CONFIG['OS_ARCH'] == 'Darwin':
    SOURCES += ['ElementVideoStreamMac.mm']
    OS_LIBS += ['-framework CoreImage']
    LOCAL_INCLUDES += [
        '/gfx/2d',
        '/gfx/layers',
    ]

LOCAL_INCLUDES += [
    '/widget',
    '/widget/headless',
]

LOCAL_INCLUDES += [
    '/third_party/aom/third_party/libwebm',
]

SOURCES += [
    '/third_party/aom/third_party/libwebm/mkvmuxer/mkvmuxer.cc',
    '/third_party/aom/third_party/libwebm/mkvmuxer/mkvmuxerutil.cc',
    '/third_party/aom/third_party/libwebm/mkvmuxer/mkvwriter.cc',
    'WebMFileWriter.cpp',
]

include('/dom/media/webrtc/third_party_build/webrtc.mozbuild')
include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'
